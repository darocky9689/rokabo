RewriteEngine On

# Nur existierende DATEIEN direkt ausliefern - bewusst ohne -d.
#
# Next 16 legt neben preise.html zusaetzlich ein Verzeichnis preise/ mit den
# Prefetch-Daten der Client-Navigation an. Wuerde diese Regel Verzeichnisse
# durchreichen, uebernaehme mod_dir und leitete /preise per 301 auf /preise/
# um - der Canonical zeigt aber auf die Fassung ohne Schraegstrich. Genau
# dieses "Canonical zeigt auf eine Weiterleitung" war schon einmal die
# Ursache von rund 18 gemeldeten SEO-Fehlern.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Verzeichnisse MIT eigener index.html an mod_dir durchreichen. Zwingend
# fuer die Wurzel einer Subdomain, deren Docroot genau so ein Verzeichnis
# ist: dort ist der angefragte Pfad leer, und keine der Regeln darunter
# kann greifen, weil ihr Muster mindestens ein Zeichen verlangt.
# Verzeichnisse OHNE index.html - also die Prefetch-Ordner von Next 16 -
# laufen bewusst nicht hier hinein, sonst leitet mod_dir wieder um.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# /pfad ohne Schraegstrich auf ein Verzeichnis mit index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# /pfad und /pfad/ auf pfad.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Ergaenzt die Regel oben: kein automatisches 301 auf die Schraegstrich-Form.
DirectorySlash Off
# Und kein Verzeichnislisting, falls doch einmal nichts greift.
Options -Indexes

DirectoryIndex index.html

# Ohne diese Zeile liefert Apache bei unbekannten URLs seine eigene nackte
# Fehlerseite statt der gestalteten 404-Seite aus dem Export.
ErrorDocument 404 /404.html

# Guertel und Hosentraeger: das Anfrage-Log wird ausserhalb des Docroots
# geschrieben. Falls es doch einmal hier landet, ist es nicht abrufbar.
<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

# ============================================================
# Kompression
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
# Cache
# Alles unter /_next/static/ traegt einen Inhaltshash im Dateinamen und
# kann daher unbegrenzt gecacht werden. HTML dagegen nie, sonst wirkt ein
# Deploy erst nach Ablauf des Caches.
# ============================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bilder liegen unter /images/ ohne Hash im Namen - deshalb begrenzt,
  # nicht "immutable".
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ==========================================================
  # Security-Header
  # ==========================================================
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
